# Copy to .env.development (dev branch) and .env.test (test branch).
# Production values live in Vercel, never in a local file.
# Pooled URL (host contains -pooler): used by the app.
DATABASE_URL=
# Direct URL (host without -pooler): used by migrations and Prisma Studio.
DIRECT_URL=
# Signs the session cookie. At least 32 random characters, e.g. `openssl rand -base64 32`.
SESSION_SECRET=
# Web Push (notifications). Make the pair with `pnpm exec web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact given to the push services: the address of the site, https://...
VAPID_SUBJECT=
# Protects /api/cron/reminders (Vercel Cron sends it as a Bearer token). At least 32 random characters.
CRON_SECRET=
